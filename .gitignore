# Data snapshots (keep latest, ignore old history)
data/history/*
!data/history/.gitkeep
data/latest.json.bak

# Reports — HTML pushed for GitHub Pages, others ignored
reports/*.md
reports/latest-alert.txt

# Runtime logs
logs/

# Sensitive config (contains bot tokens)
config/output.json

# Brainstorm session files
.superpowers/

# Claude local settings
.claude/

# OS files
.DS_Store

# Editor files
*.swp
*.swo
*~

# Intermediate collector output (runtime artifact)
data/collected.json
